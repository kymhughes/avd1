# terraform.tfvars.example — copy to terraform.tfvars and fill values
avdLocation           = "australiaeast"
prefix                = "poc1"
environment           = "prod"
spoke_subscription_id = "00000000-0000-0000-0000-000000000000"
rdsh_count            = 2
vm_size               = "Standard_D2s_v5"
local_admin_username  = "avdadmin"
publisher             = "MicrosoftWindowsDesktop"
offer                 = "windows-11"
sku                   = "win11-24h2-avd"
# From module 01 output: rg_compute_name
rg_compute_name       = "rg-avd-poc1-prod-australiaeast-pool-compute"
# From module 02 output: subnet_id
subnet_id             = "/subscriptions/.../subnets/snet-avd-hp-austr-poc1-001"
# From module 04 output: vm_password_value  — set as a pipeline SECRET VARIABLE, never in plain tfvars
# vm_password         = ""   # DO NOT commit this value — pass via -var in pipeline
# From module 05 outputs: hostpool_name, registration_token
hostpool_name         = "vdpool-poc1-prod-australiaeast"
# registration_token  = ""   # DO NOT commit — pass via pipeline secret variable
